#!/bin/bash

# A 7-digit directory is a corlogic workdir; it carries its own ./pr results script
if [[ "$(basename "${PWD}")" =~ ^[0-9]{7}$ ]]; then
  if [ -x ./pr ]; then exec ./pr "$@"; fi
  echo "This looks like a corlogic workdir (7-digit name) but it has no ./pr script. Terminating."
  exit 1
fi

~/mariadb-qa/pquery-results.sh
if [ $[ ${RANDOM} % 10 ] -eq 0 ]; then ${HOME}/mariadb-qa/mariadb-build-qa/clean_newbugs >/dev/null 2>&1 & fi  # Curate the deposit dir now and then
