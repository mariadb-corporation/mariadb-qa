#!/usr/bin/env bash
# Claude Code find: search top-level session logs for a regex and print matching session IDs.
# Nested subagents/ logs (agent-*.jsonl, journal.jsonl, workflow logs) are skipped;
# only top-level session files are searched.
# Usage:
#   clf <regex>             — list the top 13 matching sessions, most hits first
#   clf <regex> --all       — list every matching session
#   clf 'claude.*git'       — example: lines containing 'claude' followed by 'git'
# The pattern is a Python regex (re.search, case-insensitive) and is matched
# against the raw JSONL lines as well as the extracted message text content.
# Output: one row per matching session, sorted by hit count descending, under a
# bold header. The columns are the session id, its internal name (the CLAUDE INT
# column of 's'), its screen, the time of its last message, the hit count, the
# working dir and the first prompt.
# Rows are coloured like 's': blue means that session runs right now, orange that
# its working dir is gone, grey that nothing was ever asked in it. Green is the
# session you are in. A value that did not fit its column ends in a '>'.
# The prompt column holds the first prompt the user typed. A Stop hook wrapper is
# reduced to its condition text, and /compact, status? and continue lines are
# passed over.
# <screen> is the screen id to reattach with: screen -d -r <screen>. It is "-"
# when the session has no live claude process, or that process is not in screen.
# Created by Roel Van de Paar, MariaDB (with Claude Code assistance)

PROJECTS_DIR="${HOME}/.claude/projects"

if [ ! -d "$PROJECTS_DIR" ]; then
  echo "No $PROJECTS_DIR — nothing to search." >&2
  exit 1
fi

SHOW_ALL=0
PATTERN=""
for arg in "$@"; do
  if [ "$arg" = "--all" ]; then
    SHOW_ALL=1
  elif [ -z "$PATTERN" ]; then
    PATTERN="$arg"
  fi
done

if [ -z "$PATTERN" ]; then
  echo "Usage: clf <regex> [--all]    (e.g. clf 'claude.*git')" >&2
  exit 2
fi

python3 - "$PROJECTS_DIR" "$PATTERN" "$SHOW_ALL" <<'PYEOF'
import datetime, json, os, re, subprocess, sys, time

projects_dir = sys.argv[1]
pattern_str = sys.argv[2]
show_all = sys.argv[3] == "1"
TOP_N = 13

CLK_TCK = os.sysconf("SC_CLK_TCK")
BOOT_TIME = 0
try:
    for _line in open("/proc/stat"):
        if _line.startswith("btime"):
            BOOT_TIME = int(_line.split()[1])
            break
except OSError:
    pass
START_CACHE = {}

# The colours are 256-colour indices. GNU screen 4 has no 24-bit colour: it reads a
# 38;2;R;G;B sequence as SGR 2 and paints the whole line faint grey
BOLD = GREY = BLUE = GREEN = ORANGE = OFF = ""
if sys.stdout.isatty():
    BOLD, OFF = "\033[1m", "\033[0m"
    GREY, BLUE, GREEN, ORANGE = "\033[38;5;246m", "\033[38;5;75m", "\033[38;5;114m", "\033[38;5;173m"

HERE = os.environ.get("CLAUDE_CODE_SESSION_ID", "")  # the session this runs in

def running(pid, procstart):
    """True when that pid is still the claude process the store recorded."""
    if not pid:
        return False
    try:
        with open(f"/proc/{pid}/stat", "r") as fh:
            fields = fh.read().rpartition(") ")[2].split()
        return fields[19] == str(procstart)  # start time, so a reused pid cannot pass
    except (OSError, IndexError):
        return False

def load_names():
    """session id -> internal name, and the ids running right now."""
    names, live, seen = {}, set(), {}
    store = os.path.join(os.path.expanduser("~"), ".claude", "sessions")
    try:
        entries = os.listdir(store)
    except OSError:
        return names, live
    for e in entries:
        if not e.endswith(".json"):
            continue
        full = os.path.join(store, e)
        try:
            with open(full, "r", encoding="utf-8", errors="replace") as fh:
                obj = json.load(fh)
            mtime = os.path.getmtime(full)
        except Exception:
            continue
        sid, name = obj.get("sessionId") or "", obj.get("name") or ""
        if not sid:
            continue
        if name and mtime >= seen.get(sid, 0):  # a reused name belongs to the newest
            seen[sid] = mtime
            names[sid] = name
        if running(obj.get("pid"), obj.get("procStart")):
            live.add(sid)
    return names, live

NAMES, LIVE = load_names()

def row_colour(sid, cwd, prompt):
    """The colour of a whole row."""
    if sid == HERE:
        return BOLD + GREEN
    if cwd and not os.path.isdir(cwd):
        return ORANGE
    if sid in LIVE:
        return BLUE
    if not prompt:
        return GREY
    return ""

def fit(text, width):
    """text in width columns, keeping its lead, a cut marked with a >."""
    if width <= 0:
        return ""
    return text if len(text) <= width else text[:width - 1] + ">"

try:
    pattern = re.compile(pattern_str, re.IGNORECASE)
except re.error as e:
    print(f"clf: invalid regex: {e}", file=sys.stderr)
    sys.exit(3)

sessions = []
for dirpath, _, files in os.walk(projects_dir):
    for f in files:
        if not f.endswith(".jsonl"):
            continue
        path = os.path.join(dirpath, f)
        if f"{os.sep}subagents{os.sep}" in path:
            continue
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            continue
        sid = f[:-6]
        sessions.append((mtime, sid, path))

sessions.sort(reverse=True)

def extract_text(obj):
    """Pull plain text out of a log line's message content (str or list-of-blocks)."""
    msg = obj.get("message") or {}
    content = msg.get("content")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for block in content:
            if isinstance(block, dict):
                t = block.get("text") or block.get("content") or ""
                if isinstance(t, str):
                    parts.append(t)
        return "\n".join(parts)
    return ""

def proc_stat(pid):
    """(comm, ppid, start_time_epoch) for a pid, or None."""
    try:
        raw = open(f"/proc/{pid}/stat").read()
    except OSError:
        return None
    close = raw.rfind(")")
    if close < 0:
        return None
    comm = raw[raw.find("(") + 1:close]
    fields = raw[close + 2:].split()
    try:
        return comm, fields[1], BOOT_TIME + int(fields[19]) / CLK_TCK
    except (IndexError, ValueError):
        return None

def screen_of(pid):
    """The screen session id a pid runs under, by walking its parents."""
    for _ in range(40):
        st = proc_stat(pid)
        if not st:
            return None
        comm, ppid, _ = st
        if comm.lower() == "screen":
            return pid
        if ppid in ("0", "1"):
            return None
        pid = ppid
    return None

def session_start(path):
    """Epoch of the first timestamped record in a session log."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if i > 15:
                    break
                try:
                    ts = json.loads(line).get("timestamp")
                except Exception:
                    continue
                if ts:
                    return datetime.datetime.fromisoformat(
                        ts.replace("Z", "+00:00")).timestamp()
    except OSError:
        pass
    return None

def session_end(path):
    """Epoch of the last timestamped record in a session log."""
    try:
        with open(path, "rb") as fh:
            fh.seek(0, os.SEEK_END)
            fh.seek(max(0, fh.tell() - 65536))
            tail = fh.read().decode("utf-8", "replace")
    except OSError:
        return None
    for line in reversed(tail.splitlines()):
        try:
            ts = json.loads(line).get("timestamp")
        except Exception:
            continue
        if ts:
            return datetime.datetime.fromisoformat(
                ts.replace("Z", "+00:00")).timestamp()
    return None

def live_screens(all_sessions):
    """Map session id -> screen id, for sessions a live claude is running.

    A resumed session carries its id on the command line, so that mapping is
    exact. A session started plain does not, and is matched on its directory
    plus the closest start time.
    """
    by_dir = {}
    for _, sid, path in all_sessions:
        by_dir.setdefault(os.path.dirname(path), []).append((sid, path))
    try:
        ps = subprocess.run(["ps", "-eo", "pid,args"],
                            capture_output=True, text=True).stdout
    except OSError:
        return {}
    exact, guess, started = {}, {}, {}
    for line in ps.splitlines():
        parts = line.split(None, 1)
        if len(parts) != 2 or os.path.basename(parts[1].split()[0]) != "claude":
            continue
        pid, args = parts
        st = proc_stat(pid)
        if not st:
            continue
        proc_start = st[2]
        argv = args.split()
        if "--resume" in argv:
            i = argv.index("--resume")
            if i + 1 < len(argv):
                sid = argv[i + 1]
                if sid not in exact or proc_start > started.get(sid, 0):
                    exact[sid] = screen_of(pid)
                    started[sid] = proc_start
            continue
        try:
            cwd = os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            continue
        best = None
        for sid, path in by_dir.get(
                os.path.join(projects_dir, cwd.replace(os.sep, "-")), []):
            if path not in START_CACHE:
                START_CACHE[path] = session_start(path)
            begin = START_CACHE[path]
            if begin is None:
                continue
            delta = abs(begin - proc_start)
            if delta <= 600 and (best is None or delta < best[0]):
                best = (delta, sid)
        if best and (best[1] not in guess or best[0] < guess[best[1]][0]):
            guess[best[1]] = (best[0], screen_of(pid))
    out = {sid: scr for sid, (_, scr) in guess.items() if scr}
    out.update({sid: scr for sid, scr in exact.items() if scr})
    return out

STOP_HOOK_PREFIX = "A session-scoped Stop hook is now active with condition:"
SKIP_PROMPTS = {"/compact", "status?", "status ?", "continue", "continue."}

def unwrap_stop_hook(text):
    """The user's own wording, taken out of the Stop hook wrapper around it."""
    if not text.startswith(STOP_HOOK_PREFIX):
        return text
    body = text[len(STOP_HOOK_PREFIX):].lstrip()
    if not body.startswith('"'):
        return text
    body = body[1:]
    end = body.rfind('".')
    return body[:end] if end > 0 else body

def first_user_prompt(path):
    cwd, text = "", ""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                try:
                    obj = json.loads(line)
                except Exception:
                    continue
                if obj.get("type") != "user":
                    continue
                if not cwd:
                    cwd = obj.get("cwd", "") or ""
                candidate = extract_text(obj)
                stripped = candidate.lstrip()
                if stripped.startswith("<local-command-") or stripped.startswith("<command-") or stripped.startswith("<bash-"):
                    continue
                candidate = unwrap_stop_hook(stripped)
                if " ".join(candidate.split()).lower() in SKIP_PROMPTS:
                    continue
                if candidate.strip():
                    text = candidate
                    break
    except OSError:
        pass
    return cwd, text

def count_matches(path):
    hits = 0
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if pattern.search(line):
                    hits += 1
                    continue
                try:
                    obj = json.loads(line)
                except Exception:
                    continue
                txt = extract_text(obj)
                if txt and pattern.search(txt):
                    hits += 1
    except OSError:
        pass
    return hits

screens = live_screens(sessions)

rows = []
for mtime, sid, path in sessions:
    hits = count_matches(path)
    if hits == 0:
        continue
    cwd, prompt = first_user_prompt(path)
    ts = time.strftime("%d/%m %H:%M", time.localtime(session_end(path) or mtime))
    cwd_short = cwd.replace(os.path.expanduser("~"), "~") if cwd else "?"
    prompt_line = " ".join(prompt.split())[:200] if prompt else "(no user prompt)"
    rows.append((sid, NAMES.get(sid, ""), screens.get(sid, "-"), ts, hits,
                 cwd_short, prompt_line, row_colour(sid, cwd, prompt)))

if not rows:
    print(f"No sessions matched /{pattern_str}/i.", file=sys.stderr)
    sys.exit(4)

rows.sort(key=lambda r: r[4], reverse=True)
shown = rows if show_all else rows[:TOP_N]

NAMEMAX = 17  # the CLAUDE INT cap 's' uses
CWDMAX = 22  # a path is cut at its tail, so its lead shows
LINEMAX = 125  # the whole line, so the first prompt takes the room that is left
TITLE = ("CL. SID", "CLAUDE INT", "SCREEN", "LAST USED", "HITS", "CWD", "FIRST PROMPT")
sid_w = max(len(TITLE[0]), 8)  # ids are shown at 8
name_w = max(len(TITLE[1]), min(NAMEMAX, max(len(r[1]) for r in shown)))
scr_w = max(len(TITLE[2]), max(len(r[2]) for r in shown))
when_w = max(len(TITLE[3]), max(len(r[3]) for r in shown))
hit_w = max(len(TITLE[4]), max(len(str(r[4])) for r in shown))
cwd_w = max(len(TITLE[5]), min(CWDMAX, max(len(r[5]) for r in shown)))
width = LINEMAX
if sys.stdout.isatty():
    try:
        width = min(width, os.get_terminal_size(sys.stdout.fileno()).columns)
    except OSError:
        pass
prompt_w = max(0, width - (sid_w + 2 + name_w + 2 + scr_w + 2 + when_w + 2 + hit_w + 2 + cwd_w + 2))

head = (f"{TITLE[0]:<{sid_w}}  {TITLE[1]:<{name_w}}  {TITLE[2]:<{scr_w}}  {TITLE[3]:<{when_w}}  "
        f"{TITLE[4]:>{hit_w}}  {TITLE[5]:<{cwd_w}}  {fit(TITLE[6], prompt_w)}")
print(f"{BOLD}{head.rstrip()}{OFF}")
for sid, name, scr, ts, hits, cwd_short, prompt_line, colour in shown:
    line = (f"{sid[:8]:<{sid_w}}  {fit(name, name_w):<{name_w}}  {scr:<{scr_w}}  {ts:<{when_w}}  "
            f"{hits:>{hit_w}}  {fit(cwd_short, cwd_w):<{cwd_w}}  {fit(prompt_line, prompt_w)}")
    print(f"{colour}{line.rstrip()}{OFF}")

print("", file=sys.stderr)
print(f"{len(rows)} session(s) matched /{pattern_str}/i.", file=sys.stderr)
if not show_all and len(rows) > TOP_N:
    print(f"Showing top {TOP_N} sorted by hits; {len(rows) - TOP_N} more found - use --all to see all.", file=sys.stderr)
PYEOF
