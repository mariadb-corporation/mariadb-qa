#!/bin/bash 

# Check screens for the same reducer having been started multiple times
CHECK="$(grep --binary-files=text "reducer[0-9]\+.sh" /dev/shm/*/reducer.log 2>/dev/null | sed 's|.* Reducer: ||' | uniq -c | grep --binary-files=text -v '^      1 ' | sed 's|.*/reducer|s|;s|\.sh||' | xargs -I{} echo "screen -ls | grep --binary-files=text -vE 'grep|Dead' | grep --binary-files=text -o '[0-9]\+\.{}'" | tr '\n' '\0' | xargs -0 -I{} bash -c "{}" | grep --binary-files=text -o '\.s[0-9]\+$' | grep --binary-files=text -o '[0-9]\+' | uniq -c | grep --binary-files=text -v '^      1 ')" 
if [ ! -z "${CHECK}" ]; then
  echo "Multiple screens with/for the same reducer found:"
  echo "${CHECK}"
fi
CHECK=

# Check screens for pr vs ge counts
CNT1="$(screen -ls | grep --binary-files=text '\.pr[0-9]' | grep --binary-files=text -v 'Dead' | wc -l)"
CNT2="$(screen -ls | grep --binary-files=text '\.ge[0-9]' | grep --binary-files=text -v 'Dead' | wc -l)"

if [ "${1}" != "automation" -a "${CNT1}" == "${CNT2}" ]; then  # On a mismatch the counts show in the warning header instead
  echo "pr: ${CNT1}"
  echo "ge: ${CNT2}"
fi

# A pr screen keeps a shell after its run ends, so it outlives the run. A pr screen with no pquery-run.sh below it explains a pr count above the ge count without any ge screen being missing
IDLE_PR=
for SCR in $(screen -ls | grep --binary-files=text -v 'Dead' | grep --binary-files=text -oE '[0-9]+\.pr[0-9]+'); do
  CHILD_PIDS="$(ps -o pid= --ppid ${SCR%%.*} 2>/dev/null | tr -d ' ' | tr '\n' ',' | sed 's|,$||')"
  if [ -z "${CHILD_PIDS}" ] || [ -z "$(ps -o args= --ppid ${CHILD_PIDS} 2>/dev/null | grep --binary-files=text 'pquery-run.sh')" ]; then
    IDLE_PR="${IDLE_PR} ${SCR#*.}"
  fi
done

missing_screen_info=$(screen -ls | grep --binary-files=text -o 'pr[0-9]\+' | grep --binary-files=text -v 'Dead' | sort -V | awk '
{
  counts[$0]++;
  num = substr($0, 3) + 0;
  if (num > max_num) {
    max_num = num;
  }
}
END {
  for (item in counts) {
    count_freqs[counts[item]]++;
  }
  mode = 0;
  max_freq = 0;
  for (c in count_freqs) {
    if (count_freqs[c] > max_freq || (count_freqs[c] == max_freq && c > mode)) {
      max_freq = count_freqs[c];
      mode = c;
    }
  }
  if (mode <= 1) {
    exit;
  }
  missing_items = "";
  missing_count = 0;
  for (item in counts) {
    if (counts[item] < mode) {
      num = substr(item, 3) + 0;
      if (num != max_num) {
        missing_items = (missing_items == "" ? "" : missing_items ", ") item;
        missing_count++;
      }
    }
  }
  #TODO: This does not work when starting multiple runs with different counts, for example pr1-pr6 and an additional pr1-pr4 run
  #if (missing_count == 1) {
  #  print "one pr screen - " missing_items " - appears to be missing!";
  #} else if (missing_count > 1) {
  #  print "multiple pr screens - " missing_items " - appear to be missing!";
  #}
}
')

# /dev/shm/<workdir> rundir classification: a live pquery-run writes <workdir>/pquery-run.log at least once per trial, and every 10 minutes while diskspace-paused. The rundir holds a mariadbd symlink into <workdir>/mysqld, so the workdir is read from that link and does not have to be /data/<workdir>. A rundir is stale only when the run log and the rundir itself are both older than STALE_MINS: a fresh log means the run is going, and a fresh rundir means the run is still starting up
STALE_MINS=60
SGE_SUGGESTIONS=
STALE_RUNDIRS=
STALE_AGE=
for WD in $(ls --color=never -1d /dev/shm/[0-9][0-9][0-9][0-9][0-9][0-9] 2>/dev/null | sed 's|/dev/shm/||'); do
  RUN_WORKDIR="$(readlink /dev/shm/${WD}/mariadbd 2>/dev/null | sed 's|/mysqld/mariadbd$||')"
  if [ -z "${RUN_WORKDIR}" ]; then RUN_WORKDIR="/data/${WD}"; fi
  if [ -n "$(find "${RUN_WORKDIR}/pquery-run.log" -mmin -${STALE_MINS} 2>/dev/null)" ]; then
    if [ "${RUN_WORKDIR}" == "/data/${WD}" -a -z "$(screen -ls | grep --binary-files=text -v 'Dead' | grep --binary-files=text "\.ge${WD}[[:space:]]")" ]; then  # ~/sge only works for a /data workdir. A Dead screen does not count as a ge handler
      SGE_SUGGESTIONS="${SGE_SUGGESTIONS}*** Workdir ${WD} has no ge screen. Fix: ~/sge ${WD}"$'\n'
    fi
  elif [ -n "$(find /dev/shm/${WD} -maxdepth 0 -mmin +${STALE_MINS} 2>/dev/null)" ]; then
    STALE_RUNDIRS="${STALE_RUNDIRS} /dev/shm/${WD}"
    MTIME="$(stat -c %Y /dev/shm/${WD} 2>/dev/null)"
    if [ ! -z "${MTIME}" ]; then
      AGE=$(( ( $(date +%s) - MTIME ) / 60 ))
      if [ -z "${STALE_AGE}" ] || [ ${AGE} -lt ${STALE_AGE} ]; then STALE_AGE=${AGE}; fi  # Lowest age of the listed rundirs, so the reported age holds for all of them
    fi
  fi
done

EXITCODE=0
if [ "${CNT1}" != "${CNT2}" -o ! -z "${missing_screen_info}" ]; then
  echo "======= WARNING: pr:${CNT1} vs ge:${CNT2} ======="
  if [ ${CNT1} -lt ${CNT2} ]; then
    echo "More ge screens than pr: a run ended and its ge screen is still reducing."
  elif [ ${CNT1} -gt ${CNT2} -a -z "${SGE_SUGGESTIONS}" ]; then
    if [ ! -z "${IDLE_PR}" ]; then
      echo "pr screen(s) with no run:${IDLE_PR} - that run ended, so no ~/sge is needed."
    else
      echo "A run has no ge screen. Compare 's' with 'vr', then run ~/sge <workdir>."
    fi
  fi
  if [ ! -z "${missing_screen_info}" ]; then
    echo "${missing_screen_info}"
  fi
  EXITCODE=1
fi
if [ ! -z "${SGE_SUGGESTIONS}" ]; then
  printf '%s' "${SGE_SUGGESTIONS}"
  EXITCODE=1
fi
if [ ! -z "${STALE_RUNDIRS}" ]; then
  echo "*** Stale rundir(s), no run activity for ${STALE_AGE:-${STALE_MINS}}+ min: rm -rf${STALE_RUNDIRS}"
  EXITCODE=1
fi
if [ ${EXITCODE} -eq 1 ]; then echo ''; fi  # Separates the warnings from the caller's own output
exit ${EXITCODE}
