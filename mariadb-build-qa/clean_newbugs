#!/bin/bash
set +H

# This script, by default, cleans up /data/NEWBUGS (or instead any directory passed as the first option to this script) by indexing all seen bugs into a newbugs.list (using 'find' as 'ls' will easily report 'ls: Argument list too long' for this directory as it often has 300-800k files in it). Then this list is reviewed and for the first KEEP_OCCURRENCES occurrences of any string, that bug/index is kept (iow the string, sql, varmod and reducer files are kept). This thus eliminates duplicates beyond KEEP_OCCURRENCES, as well as any bug which is listed as known in known_bugs.strings. The string files are read, and the filtered bugs are deleted, by THREADS parallel workers. All temporary files are written to a work directory on /dev/shm (or on the target or /tmp filesystem if /dev/shm has less than MIN_WORK_SPACE free), so a target disk which is out of space does not stop this script from freeing space on it.

# User variables
ENABLE_OUTPUT=1    # 0 For silence, 1 For output
KNOWN_BUGS="${HOME}/mariadb-qa/known_bugs.strings"
KEEP_OCCURRENCES=2  # 1, 2, or 3. Keep this number of occurrences
THREADS=16          # Parallel workers reading string files and deleting files
MIN_WORK_SPACE=1048576  # Free space (in KB) a filesystem needs to host the work directory
MIN_INTERVAL=600    # Minimum nr of seconds between two runs for the same target directory

# System variable(s) and options check
TARGET=
if [ ! -r ${KNOWN_BUGS} ]; then echo "Assert: KNOWN_BUGS file ('${KNOWN_BUGS}' as set in this script) not readable!"; exit 1; fi
if [ ! -z "${1}" ]; then 
  if [ -d "${1}" ]; then
    TARGET="${1}"
  else
    echo "Assert: '${1}' was specified as an option to this script, however that directory does not exist, or the option specified existed but was not a directory."
    exit 1
  fi
else
  if [ -d "/data/NEWBUGS" ]; then
    TARGET="/data/NEWBUGS"
  else
    echo "Assert: no option was specified to this script, and /data/NEWBUGS does not exist: it is thus unknown which directory this script should cleanup."
    exit 1
  fi
fi
if [ -z "${TARGET}" ]; then echo "Assert: TARGET is empty."; exit 1; fi  # Dev assert

# This script is called from many places (~/ds, ~/pr, ~/gomd, ~/newbug, ~/kb, ~/kba and the reducer), so the lock file below both locks out a second run on the same target and holds the time of the last run: a run started within MIN_INTERVAL seconds of the last one stops here. The time is set before the work starts, so an interrupted run does not open the door to a run per call
LOCK="/tmp/clean_newbugs.$(basename "$(readlink -f "${TARGET}")").lock"
LAST=0
if [ -f "${LOCK}" ]; then LAST="$(stat -c %Y "${LOCK}" 2>/dev/null)"; fi
if [ -z "${LAST}" ]; then LAST=0; fi
exec 9>>"${LOCK}"
if ! flock -n 9; then
  if [ ${ENABLE_OUTPUT} -eq 1 ]; then echo "Assert: ./clean_newbugs is already running for ${TARGET}!"; fi
  exit 1
fi
AGE=$[ $(date +%s) - ${LAST} ]
if [ ${AGE} -lt ${MIN_INTERVAL} ]; then
  if [ ${ENABLE_OUTPUT} -eq 1 ]; then echo "The last cleanup of ${TARGET} was ${AGE} seconds ago, and MIN_INTERVAL is ${MIN_INTERVAL} seconds: nothing to do"; fi
  exit 0
fi
touch "${LOCK}"

# Work directory: /dev/shm is used first as it is memory backed and it leaves the target disk untouched
WORK=
for DIR in /dev/shm "${TARGET}" /tmp; do
  SPACE="$(df -kP "${DIR}" 2>/dev/null | awk 'NR==2{print $4}')"
  if [ -n "${SPACE}" ] && [ "${SPACE}" -ge ${MIN_WORK_SPACE} ]; then
    WORK="$(mktemp -d "${DIR}/cnb.XXXXXX" 2>/dev/null)"
    if [ -n "${WORK}" ]; then break; fi
  fi
done
if [ -z "${WORK}" ]; then echo "Assert: no filesystem with ${MIN_WORK_SPACE}KB free was found to hold the work directory (tried /dev/shm, ${TARGET}, /tmp)"; exit 1; fi
trap "rm -Rf ${WORK}" EXIT INT TERM

# Start main de-duplicaton and known bugs cleanup
if [ ${ENABLE_OUTPUT} -eq 1 ]; then
  echo "Commencing de-duplication and known bugs cleanup of ${TARGET}"
  echo ".. Changing to target directory ${TARGET}"
  echo ".. Using work directory ${WORK}"
fi
cd "${TARGET}" || exit 1
if [ ${ENABLE_OUTPUT} -eq 1 ]; then
  echo ".. Compiling sorted newbugs.list of strings"
fi
# The following find/sort ensures that the oldest seen issues are listed first, ensuring that the same reducers are kept run-over-run of ./clean_newbugs and thereby avoiding deletion of running reducers by for example the ~/ds watchdog
/usr/bin/find . -maxdepth 1 -type f -name '*.string' -printf '%A@\t%p\n' 2>/dev/null | LC_ALL=C sort -t$'\t' -k1,1n -T "${WORK}" | cut -f2- > "${WORK}/newbugs.list"
if [ ! -r "${WORK}/newbugs.list" ]; then echo "Assert: '${WORK}/newbugs.list' does not exist after creating the same"; exit 1; fi

COUNT="$(wc -l < "${WORK}/newbugs.list" 2>/dev/null)"
if [ -z "${COUNT}" -o "${COUNT}" -le 0 ]; then 
  if [ ${ENABLE_OUTPUT} -eq 1 ]; then
    echo "Nothing to do!"
  fi
  exit 0
fi
if [ ${ENABLE_OUTPUT} -eq 1 ]; then
  echo ".. Found ${COUNT} string files"
  echo ".. Reading the string files using ${THREADS} parallel workers"
fi

# Read every string file into one 'file<TAB>string' list, in the same oldest-first order, using THREADS workers
split -d -a 6 -n "l/${THREADS}" "${WORK}/newbugs.list" "${WORK}/chunk."
for CHUNK in "${WORK}"/chunk.*; do
  awk '{RET=(getline STRING < $0); close($0); if (RET<0){next}; if (RET==0){STRING=""}; print $0 "\t" STRING}' "${CHUNK}" > "${CHUNK}.strings" &
done
wait
cat "${WORK}"/chunk.*.strings > "${WORK}/newbugs.strings"

if [ ${ENABLE_OUTPUT} -eq 1 ]; then
  echo ".. De-duplicating (${KEEP_OCCURRENCES} occurrences max), and removing known bugs"
fi
# Each filtered bug adds its string, sql, varmod and reducer file to the delete list. Strings already seen KEEP_OCCURRENCES times, and strings which are known bugs, are remembered, so each unique string is compared once only
awk -v KB="${KNOWN_BUGS}" -v KEEP="${KEEP_OCCURRENCES}" -v OUT="${ENABLE_OUTPUT}" -v COUNT="${COUNT}" -v DEL="${WORK}/delete.list" '
  BEGIN{
    while ((getline KBLINE < KB) > 0) {
      TRIM=KBLINE; sub(/^[ \t]+/,"",TRIM)
      if (TRIM=="") { continue }
      if (substr(TRIM,1,1)=="#") { continue }  # Bugs marked as fixed need to be excluded
      KBN++; KBLIST[KBN]=tolower(KBLINE)
    }
    close(KB)
    BACKTRACE="backtrace stopped: cannot access memory at address"
  }
  {
    TAB=index($0,"\t"); if (TAB==0) { next }
    FILE=substr($0,1,TAB-1); STRING=tolower(substr($0,TAB+1))
    IDX++
    if (!(STRING in KNOWN)) {
      KNOWN[STRING]=0
      for (I=1; I<=KBN; I++) { if (index(KBLIST[I],STRING)>0) { KNOWN[STRING]=1; break } }
    }
    if (KNOWN[STRING]==1) {
      if (OUT==1) { print ".... [" IDX "/" COUNT "] " FILE ": already known issue: filtering" }
      FILTER=1
    } else if (index(STRING,BACKTRACE)>0) {  # An unusable backtrace: no UniqueID can be established
      if (OUT==1) { print "... [" IDX "/" COUNT "] " FILE ": backtrace stopped: filtering" }
      FILTER=1
    } else if (STRING in FULL) {
      if (OUT==1) { print "... [" IDX "/" COUNT "] " FILE ": new issue, occurrence >=" FULL[STRING] ": filtering" }
      FILTER=1
    } else {
      DUPS=0
      for (I=1; I<=KEPTN; I++) { if (index(KEPT[I],STRING)>0) { DUPS++ } }
      if (DUPS > KEEP-1) {
        FULL[STRING]=DUPS+1
        if (OUT==1) { print "... [" IDX "/" COUNT "] " FILE ": new issue, occurrence >=" DUPS+1 ": filtering" }
        FILTER=1
      } else {
        KEPTN++; KEPT[KEPTN]=STRING
        if (OUT==1) { print "... [" IDX "/" COUNT "] " FILE ": new issue, occurrence " DUPS+1 "/" KEEP ": keeping" }
        FILTER=0
      }
    }
    if (FILTER==1) {
      if (FILE !~ /^\.\/newbug_/) { next }  # Only ever delete newbug files
      if (FILE !~ /\.string$/) { next }
      STEM=substr(FILE,1,length(FILE)-7)
      print STEM ".string" > DEL
      print STEM ".sql" > DEL
      print STEM ".varmod" > DEL
      print STEM ".reducer.sh" > DEL
    }
  }' "${WORK}/newbugs.strings"

if [ -s "${WORK}/delete.list" ]; then
  if [ ${ENABLE_OUTPUT} -eq 1 ]; then
    echo ".. Deleting $(wc -l < "${WORK}/delete.list") files using ${THREADS} parallel workers"
  fi
  xargs -r -d '\n' -P ${THREADS} -n 500 rm -f < "${WORK}/delete.list"
fi

# Other data cleanup
rm 1[6-9]*_* 2>/dev/null  # {epoch}_run, {epoch}_start etc. scripts created by reducer (can easily be recreated if needed)
rm -f ./newbugs.list ./newbugs.dedup  # Leftovers of an interrupted run

# Fireworks cleanup
if [ -d /data/FIREWORKS ]; then 
  awk '!/^#/ { LINE=$0; sub(/[ \t]+##.*$/,"",LINE); if (LINE !~ /^[ \t]*$/) { print LINE } }' "${KNOWN_BUGS}" > "${WORK}/known.patterns"  # An empty pattern would match every string file, so blank lines are dropped after the trailing comment is stripped
  /usr/bin/find /data/FIREWORKS -maxdepth 1 -type f -name '*.string' -print0 2>/dev/null | xargs -0 -r -P ${THREADS} -n 500 grep -liF --binary-files=text -f "${WORK}/known.patterns" 2>/dev/null | sed 's|\.string$||' | xargs -r -d '\n' -P ${THREADS} -n 100 bash -c 'for BASE; do rm -f "${BASE}".*; done' _
  if [ ${ENABLE_OUTPUT} -eq 1 ]; then
    echo '.. Fireworks cleaned'
  fi
fi

if [ ${ENABLE_OUTPUT} -eq 1 ]; then
  echo ".. Done"
fi
